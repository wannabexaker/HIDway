/* Version resource shared by the HIDway executables (Explorer > Properties >
 * Details). Define HIDWAY_RC_DESCRIPTION and HIDWAY_RC_FILENAME, include
 * hidway_version.h (generated), then include this file. */

1 VERSIONINFO
FILEVERSION HIDWAY_VERSION_NUM
PRODUCTVERSION HIDWAY_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HIDway"
      VALUE "FileDescription", HIDWAY_RC_DESCRIPTION
      VALUE "FileVersion", HIDWAY_VERSION_DOT
      VALUE "InternalName", HIDWAY_RC_FILENAME
      VALUE "LegalCopyright", "Copyright (c) 2026 wannabexaker. MIT License."
      VALUE "OriginalFilename", HIDWAY_RC_FILENAME
      VALUE "ProductName", "HIDway"
      VALUE "ProductVersion", HIDWAY_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
