# Version from the release tag: `git describe` of the source tree, e.g.
# "v0.3.0", or "v0.3.0-4-g1a2b3c4" four commits later ("-dirty" with local
# changes); "dev" without git. HIDWAY_VERSION (-D) overrides it.
#
# include() it for hidway_version(<var> <source dir>), or run it as a script to
# write a header that is replaced only when the version changes:
#   cmake -DSRC=<source dir> -DOUT=<header> [-DVERSION=<override>] -P hidway_version.cmake

function(hidway_version out_var src)
    set(v "")
    find_package(Git QUIET)
    if (GIT_FOUND)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${src}" describe --tags --match "v[0-9]*" --always --dirty
                        OUTPUT_VARIABLE v OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if (NOT rc EQUAL 0)
            set(v "")
        endif ()
    endif ()
    if (v STREQUAL "")
        set(v "dev")
    endif ()
    set(${out_var} "${v}" PARENT_SCOPE)
endfunction()

# "v1.2.3[-N-g<hash>]" -> "1;2;3;N" (N = 0 on the tag itself); anything else -> 0;0;0;0
function(hidway_version_numbers out_var version)
    if (version MATCHES "^v([0-9]+)\\.([0-9]+)\\.([0-9]+)(-([0-9]+)-g)?")
        set(n "${CMAKE_MATCH_5}")
        if (n STREQUAL "")
            set(n 0)
        endif ()
        set(${out_var} "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3};${n}" PARENT_SCOPE)
    else ()
        set(${out_var} "0;0;0;0" PARENT_SCOPE)
    endif ()
endfunction()

if (CMAKE_SCRIPT_MODE_FILE AND DEFINED OUT)
    if (DEFINED VERSION AND NOT VERSION STREQUAL "")
        set(ver "${VERSION}")
    else ()
        hidway_version(ver "${SRC}")
    endif ()
    hidway_version_numbers(num "${ver}")
    list(JOIN num "," num_comma)
    list(JOIN num "." num_dot)
    set(text "/* Generated by cmake/hidway_version.cmake; do not edit. */
#define HIDWAY_VERSION \"${ver}\"
#define HIDWAY_VERSION_NUM ${num_comma}
#define HIDWAY_VERSION_DOT \"${num_dot}\"
")
    set(old "")
    if (EXISTS "${OUT}")
        file(READ "${OUT}" old)
    endif ()
    if (NOT old STREQUAL text)
        file(WRITE "${OUT}" "${text}")
    endif ()
endif ()
