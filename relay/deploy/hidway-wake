#!/usr/bin/env bash
# hidway-wake - wake the target PC with a Wake-on-LAN magic packet.
#
#   hidway-wake                     # HIDWAY_WAKE_MAC / HIDWAY_WAKE_TO from
#                                   # /etc/hidway/hidwayd.conf
#   hidway-wake MAC [IPv4[:PORT]]   # explicit
#
# HIDWAY_WAKE_TO is the target's broadcast address on this network (the
# default), or a router that forwards the UDP port to the target. See
# docs/RELAY.md, "Wake-on-LAN". No root needed.
set -euo pipefail

CONF=${HIDWAY_CONF:-/etc/hidway/hidwayd.conf}
HIDWAYD=${HIDWAYD:-/opt/hidway/current/hidwayd}

# Value of KEY=value in the config (last one wins), read without executing it.
conf_get() { # conf_get <KEY>
    local line val=
    [[ -r $CONF ]] || return 0
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*$1=(.*)$ ]] || continue
        val=${BASH_REMATCH[1]%%#*} # drop a trailing comment
        val=${val//[\"\' $'\t']/} # drop quotes and blanks
    done <"$CONF"
    printf '%s' "$val"
}

mac=${1:-$(conf_get HIDWAY_WAKE_MAC)}
to=${2:-$(conf_get HIDWAY_WAKE_TO)}
if [[ -z $mac ]]; then
    echo "hidway-wake: no MAC address: set HIDWAY_WAKE_MAC in $CONF or pass one" >&2
    exit 2
fi
exec "$HIDWAYD" --wake "$mac" ${to:+--wake-to "$to"}
